model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["CaminhoBanco", "dim_data", "dim_produto", "fato_preco_diario", "top_descontos"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table dim_data
ref table dim_produto
ref table fato_preco_diario
ref table top_descontos
