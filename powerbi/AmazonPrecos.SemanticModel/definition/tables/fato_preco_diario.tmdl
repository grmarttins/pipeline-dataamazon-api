table fato_preco_diario
	lineageTag: 57566183-a90e-489a-98c9-509fdc6f79cb

	measure 'Produtos Monitorados' = DISTINCTCOUNT(fato_preco_diario[codigo_produto])
		formatString: #,0
		lineageTag: d9d46dc8-1d2d-4ac1-a9da-3c293fcd1cf1

	measure 'Preço Médio' = AVERAGE(fato_preco_diario[preco])
		formatString: \R$ #,0.00
		lineageTag: b64d7203-101e-44de-bf3f-f968a1bcc7ce

	measure 'Desconto Médio' = AVERAGE(fato_preco_diario[desconto_pct])
		formatString: 0.0%
		lineageTag: 299c8233-0b51-472c-bf05-5ef0b5a84898

	measure '% com Desconto' = DIVIDE(CALCULATE(COUNTROWS(fato_preco_diario), fato_preco_diario[tem_desconto] = TRUE()), COUNTROWS(fato_preco_diario))
		formatString: 0.0%
		lineageTag: d0f9bbb5-3219-4e28-a383-c616c489e154

	measure 'Avaliação Média' = AVERAGE(fato_preco_diario[avaliacao_media])
		formatString: 0.00
		lineageTag: 1d5ab8a6-1bd4-480e-a5c9-d5558487d324

	measure 'Vendas Estimadas' = SUM(fato_preco_diario[volume_vendas_estimado])
