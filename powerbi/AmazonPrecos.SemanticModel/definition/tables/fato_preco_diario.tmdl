	partition fato_preco_diario = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("driver={DuckDB Driver};database=" & CaminhoBanco & ";access_mode=read_only",
				        "SELECT * FROM gold.fato_preco_diario"),
				    Tipos = Table.TransformColumnTypes(Fonte, {{"codigo_produto", type text}, {"data", type date}, {"categoria", type text}, {"faixa_preco", type text}, {"preco", type number}, {"preco_original", type number}, {"preco_minimo_oferta", type number}, {"desconto_pct", type number}, {"tem_desconto", type logical}, {"avaliacao_media", type number}, {"quantidade_avaliacoes", Int64.Type}, {"quantidade_ofertas", Int64.Type}, {"volume_vendas_estimado", Int64.Type}, {"prime", type logical}, {"mais_vendido", type logical}, {"escolha_amazon", type logical}, {"entrega_gratis", type logical}}),
				    DescontoFracao = Table.TransformColumns(Tipos, {{"desconto_pct", each _ / 100, type number}}),
				    Resultado = Table.AddColumn(DescontoFracao, "faixa_ordem", each List.PositionOf({"Até R$50", "R$50-200", "R$200-500", "R$500-1500", "Acima de R$1500"}, [faixa_preco]), Int64.Type)
				in
				    Resultado

	annotation PBI_ResultType = Table
