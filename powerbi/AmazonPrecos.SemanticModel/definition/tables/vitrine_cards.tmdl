	partition vitrine_cards = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("driver={DuckDB Driver};database=" & CaminhoBanco & ";access_mode=read_only",
				        "SELECT * FROM gold.vitrine_cards"),
				    Tipos = Table.TransformColumnTypes(Fonte, {{"data", type date}, {"ordenacao", type text}, {"ordem_ordenacao", Int64.Type}, {"codigo_produto", type text}, {"categoria", type text}, {"posicao", Int64.Type}, {"linha", Int64.Type}, {"coluna", Int64.Type}, {"card_svg", type text}})
				in
				    Tipos

	annotation PBI_ResultType = Table

