table vitrine_cards
	lineageTag: ef0b0f4e-016a-4b28-ae94-bae08dadf871

	/// Várias datas no filtro (ou nenhuma): mostra a carta da extração mais recente entre elas
	measure 'Card Produto' = VAR UltimaData = CALCULATE(MAX(vitrine_cards[data]), ALLSELECTED(vitrine_cards)) RETURN CALCULATE(SELECTEDVALUE(vitrine_cards[card_svg]), vitrine_cards[data] = UltimaData)
		lineageTag: 914b3957-a480-4bf5-8a73-cd7ec2b55243
		dataCategory: ImageUrl

