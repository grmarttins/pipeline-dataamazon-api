	partition top_descontos = m
		mode: import
		source =
				let
				    Fonte = Odbc.Query("driver={DuckDB Driver};database=" & CaminhoBanco & ";access_mode=read_only",
				        "SELECT * FROM gold.top_descontos"),
				    Tipos = Table.TransformColumnTypes(Fonte, {{"data", type date}, {"posicao", Int64.Type}, {"codigo_produto", type text}, {"titulo_produto", type text}, {"categoria", type text}, {"preco", type number}, {"preco_original", type number}, {"desconto_pct", type number}, {"avaliacao_media", type number}}),
				    Resultado = Table.TransformColumns(Tipos, {{"desconto_pct", each _ / 100, type number}})
				in
				    Resultado

	annotation PBI_ResultType = Table
